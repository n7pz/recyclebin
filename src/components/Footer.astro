<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: rgb(16,16,15) no-repeat;
		color: var(--silver);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--silver);
	}
	.social-links a:hover {
		color: var(--textbright);
	}
</style>
